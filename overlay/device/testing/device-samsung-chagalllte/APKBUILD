# Reference: <https://postmarketos.org/devicepkg>
# Adapted from device-samsung-chagallwifi(-downstream) for the LTE variant.
pkgname=device-samsung-chagalllte
pkgdesc="Samsung Galaxy Tab S 10.5 LTE"
pkgver=1
pkgrel=0
url="https://postmarketos.org"
license="MIT"
arch="armv7"
options="!check !archcheck"
depends="
	firmware-samsung-chagall
	mkbootimg
	msm-fb-refresher
	postmarketos-base
	postmarketos-base-downstream
	postmarketos-base-downstream-disable-udev-v4l
"
makedepends="devicepkg-dev"
source="deviceinfo"
subpackages="
	$pkgname-kernel-downstream:kernel_downstream
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
}

kernel_downstream() {
	pkgdesc="Downstream 3.4 kernel (display, touch; modem hardware present but unsupported)"
	depends="linux-samsung-chagalllte"
	devicepkg_subpackage_kernel $startdir $pkgname $subpkgname
}

