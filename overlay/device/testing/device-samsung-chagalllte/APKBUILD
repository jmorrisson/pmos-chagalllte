# Reference: <https://postmarketos.org/devicepkg>
# Adapted from device-samsung-chagallwifi(-downstream) for the LTE variant.
pkgname=device-samsung-chagalllte
pkgdesc="Samsung Galaxy Tab S 10.5 LTE"
pkgver=1
pkgrel=0
url="https://postmarketos.org"
license="MIT"
arch="armv7"
options="!check !archcheck"
depends="
	# The kernel must also be a dependency of the main package (not only of
	# the kernel subpackage), otherwise `pmbootstrap install` does not walk
	# into the kernel aport and never builds it.
	linux-samsung-chagalllte
	firmware-samsung-chagall
"
makedepends="devicepkg-dev"
source="deviceinfo"
subpackages="
	$pkgname-kernel-downstream:kernel_downstream
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
}

kernel_downstream() {
	pkgdesc="Downstream 3.4 kernel (display, touch; modem hardware present but unsupported)"
	depends="linux-samsung-chagalllte"
	devicepkg_subpackage_kernel $startdir $pkgname $subpkgname
}

